{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".indexOn": ["role", "pushToken"]
    },
    "incidents": {
      ".indexOn": ["timestamp", "type", "status"]
    },
    "sosAlerts": {
      ".indexOn": ["timestamp", "status", "userId"]
    },
    "notifications": {
      ".indexOn": ["recipientId", "timestamp"]
    },
    "presence": {
      ".indexOn": ["updatedAt", "geohash"]
    },
    "responses": {
      ".indexOn": ["incidentId", "timestamp"]
    }
  }
}
