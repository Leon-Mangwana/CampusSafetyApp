# Firebase Admin SDK service account (Project settings -> Service accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Server
PORT=3000
NODE_ENV=development

# Comma-separated browser origins allowed by CORS. Native apps need none.
CORS_ORIGINS=

# Optional: serve TLS 1.3 directly instead of behind a reverse proxy.
# Generate dev certs with `npm run generate-cert`.
# HTTPS_KEY_PATH=./certs/dev-key.pem
# HTTPS_CERT_PATH=./certs/dev-cert.pem
